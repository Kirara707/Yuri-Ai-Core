# ========== 应用配置 ==========
APP_VERSION=2.0.0
DEBUG=True
ENVIRONMENT=development

# ========== FastAPI ==========
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ========== Redis ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== PostgreSQL ==========
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=yuri
POSTGRES_PASSWORD=yuri_password
POSTGRES_DB=yuri_ai_db

# ========== Celery ==========
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ========== LLM API ==========
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=kimi-k2-0905-preview
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=5
LLM_RETRY_BASE_DELAY=1.0
LLM_MAX_THREADS_DIALOGUE=7
LLM_MAX_THREADS_VERB=20

# ========== BERT ==========
BERT_MODEL_PATH=./models/checkpoint-47200
BERT_MAX_LEN=512
BERT_STRIDE=128
BERT_BATCH_SIZE=16
BERT_DEVICE=cuda

# ========== 日志 ==========
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json
LOG_RETENTION_DAYS=30

# ========== 缓存 ==========
CACHE_TTL=2592000
CACHE_ENABLED=true

# ========== 熔断器 ==========
CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=300
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
